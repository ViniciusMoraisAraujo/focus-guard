[Desktop Entry]
Type=Application
Name=FocusGuard Tray
Comment=FocusGuard — ícone da bandeja do sistema
# Exec deve apontar para o mesmo INSTALL_DIR do install-linux.sh (pasta
# protegida /opt/focusguard). O install-linux.sh reescreve o Exec no autostart.
Exec=/opt/focusguard/focusguard-tray
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
