{
  "product": "FocusGuard",
  "company": "FocusGuard",
  "icon": "packaging/focusguard.ico",
  "compression": "high",
  "upgrade-code": "6a87f38f-249f-437e-a729-4cb5c0734c0b",
  "info": {
    "comments": "FocusGuard — bloqueio focado de distrações (sites + apps).",
    "contact": "FocusGuard",
    "help-link": "https://github.com/focusguard/focusguard",
    "support-link": "https://github.com/focusguard/focusguard",
    "update-info-link": "https://github.com/focusguard/focusguard/releases",
    "readme": "FocusGuard — bloqueio focado de distrações."
  },
  "files": [
    {
      "path": "bin/focusguard.exe"
    },
    {
      "path": "bin/focusguard-daemon.exe",
      "service": {
        "name": "FocusGuard",
        "start": "auto",
        "display-name": "FocusGuard Daemon",
        "description": "Bloqueia sites e aplicativos distractivos via hosts + firewall, com agendamento, pomodoro e auto-atualização."
      }
    },
    {
      "path": "bin/focusguard-watchdog.exe",
      "service": {
        "name": "FocusGuardWatchdog",
        "start": "auto",
        "display-name": "FocusGuard Watchdog",
        "description": "Monitora o daemon FocusGuard e o reinicia se não responder."
      }
    },
    {
      "path": "bin/focusguard-tray.exe"
    },
    {
      "path": "bin/focusguard-web.exe"
    }
  ],
  "hooks": [
    {
      "command": "sc.exe failure FocusGuard reset= 86400 actions= restart/1000/restart/1000/restart/1000",
      "when": "install",
      "execute": "deferred",
      "impersonate": "no",
      "return": "ignore"
    },
    {
      "command": "sc.exe failure FocusGuardWatchdog reset= 86400 actions= restart/5000/restart/5000/restart/5000",
      "when": "install",
      "execute": "deferred",
      "impersonate": "no",
      "return": "ignore"
    },
    {
      "command": "taskkill.exe /f /im focusguard-tray.exe",
      "when": "",
      "execute": "immediate",
      "impersonate": "yes",
      "return": "ignore"
    },
    {
      "command": "cmd.exe /c start \"\" \"[INSTALLDIR]focusguard-tray.exe\"",
      "when": "install",
      "condition": "NOT REMOVE",
      "execute": "immediate",
      "impersonate": "yes",
      "return": "ignore"
    }
  ],
  "shortcuts": [
    {
      "name": "FocusGuard",
      "description": "FocusGuard - bloqueio focado de distrações",
      "location": "desktop",
      "target": "[#ApplicationFile1]",
      "wdir": "INSTALLDIR",
      "icon": "packaging/focusguard.ico"
    }
  ],
  "registries": [
    {
      "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
      "values": [
        {
          "name": "FocusGuardTray",
          "type": "string",
          "value": "&quot;[INSTALLDIR]focusguard-tray.exe&quot;"
        }
      ]
    }
  ]
}
